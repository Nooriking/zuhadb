APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=https://zuha.tezhoshan.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.tezhoshan.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=zuhaperfume.af@gmail.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="zuhaperfume.af@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

# Machine-bound license (lock install to one PC)
# On client delivery: LICENSE_ENABLED=true, LICENSE_ALLOW_ISSUE=false
# On your vendor PC only: LICENSE_ALLOW_ISSUE=true + a private LICENSE_SECRET
LICENSE_ENABLED=false
LICENSE_ALLOW_ISSUE=false
LICENSE_SECRET=
LICENSE_SUPPORT_PHONE=0744442863
LICENSE_SUPPORT_EMAIL=zuhaperfume.af@gmail.com

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ERP AI Assistant — Groq via OpenAI-compatible provider (server-side only)
# Never expose AI_API_KEY to the frontend, Inertia props, logs, or git.
# AI_PROVIDER=openai keeps the existing OpenAiProvider (Groq is OpenAI-compatible).
AI_ENABLED=false
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b
# Leave empty for Groq (OpenAI-Organization header is not used)
AI_ORGANIZATION=
# Optional HTTP(S) proxy if Groq blocks your IP/region (leave empty for direct)
# Example: AI_HTTP_PROXY=http://127.0.0.1:7890
AI_HTTP_PROXY=
AI_TIMEOUT=60
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.2
# gpt-oss does not support parallel tool calls
AI_PARALLEL_TOOL_CALLS=false
AI_RATE_LIMIT_PER_MINUTE=20
AI_RATE_LIMIT_PER_DAY=500
AI_MAX_TOOL_ROUNDS=8
AI_HISTORY_MAX_MESSAGES=40
AI_HISTORY_MAX_MESSAGE_CHARS=8000
AI_HISTORY_MAX_TITLE_CHARS=120
AI_CONVERSATIONS_PER_PAGE=50
AI_CONVERSATION_MESSAGES_LIMIT=200
# Optional override for the server-side system prompt (leave empty to use config default)
AI_SYSTEM_PROMPT=

# Phase 1E — read-only AI database intelligence
# Prefer a dedicated MySQL user with SELECT-only grants (manual setup).
# See docs/AI_READONLY_DATABASE.md — never put write credentials here for AI.
AI_DB_ENABLED=true
# Leave empty to use the default DB connection, or set mysql_ai_readonly
AI_DB_CONNECTION=
AI_DB_HOST=
AI_DB_PORT=
AI_DB_DATABASE=
AI_DB_USERNAME=
AI_DB_PASSWORD=
AI_DB_SCHEMA_CACHE_TTL=600
AI_DB_MAX_ROWS=100
AI_DB_MAX_SQL_LENGTH=5000
AI_DB_MAX_JOINS=8
AI_DB_MAX_EXECUTION_SECONDS=10
AI_DB_MAX_RESULT_CHARS=12000
AI_DB_MAX_CONCURRENT_PER_USER=2

